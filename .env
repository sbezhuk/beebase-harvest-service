# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=production

# debug | info | warn | error
LOG_LEVEL=warn

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by docker-compose to provision the postgres container, and to
# build DATABASE_URL below (kept in sync automatically - only ever
# change the password here, not in DATABASE_URL itself).
POSTGRES_USER=beebase
POSTGRES_PASSWORD=WN54w0zSJ4E6Afzgo3p0lMqcVOFKHw
POSTGRES_DB=beebase_harvest
# Overridden by beebase-gateway/docker-compose.yml to
# harvest-postgres/5432 when this service is run as part of the full
# local stack from there.
POSTGRES_HOST=localhost
POSTGRES_PORT=5437

# Used by the app. Built from the POSTGRES_* values above so the
# password never needs to be duplicated/retyped here.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Used only by `make test-integration`, never by the app itself.
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/beebase_harvest_test?sslmode=disable

# Required: the shared session store. Every BeeBase service (not just
# auth-service) checks it on every request, so an access token can be
# rejected the instant its session is superseded by a newer one instead
# of staying valid until its own JWT expiry.
REDIS_ADDR=localhost:6379
REDIS_CONNECT_TIMEOUT=5s
# `docker compose up` (via beebase-gateway) overrides this to the
# in-network Redis address — you don't need to change it for that path.

# Required: auth-service's public key endpoint, used to verify access
# tokens without ever holding a key that could mint one.
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Required: hive-service's base URL. Harvest has no ownership data of its
# own: every operation confirms the caller owns the specified hive by
# forwarding their own access token to hive-service's
# GET /api/v1/hives/{id}, on every call - not just once at creation time.
HIVE_SERVICE_URL=http://localhost:8083

# `docker compose up` (via beebase-gateway) overrides the above to
# in-network addresses — you don't need to change it for that path.
